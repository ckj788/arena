NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DB_PREFIX=shipandbattle_

# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
ADMIN_API_SECRET=
ADMIN_EMAILS=

# Stripe Hosted Checkout (server-only; keep blank until ready to test).
# Test/live mode is inferred from the secret key prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Use the exact browser origin, e.g. http://localhost:3000 for local development.
# Production requires HTTPS, e.g. https://www.indieclash.com
STRIPE_CHECKOUT_BASE_URL=
# Reusable payment links: JSON {"mode":"test","baseUrl":"http://localhost:3000","links":{"starter":{"id":"plink_...","url":"https://buy.stripe.com/..."},"growth":{...},"pro":{...}}}
# Provision once with scripts/setup-payment-links.mjs for local test mode.
STRIPE_PAYMENT_LINKS=
# Stable random server-only secret, at least 32 characters. Keep across deployments.
STRIPE_PAYMENT_LINK_SIGNING_SECRET=

# Optional local development proxy. Never required on Vercel.
INDIECLASH_DEV_PROXY=

# Resend submission confirmations. Server-only; leave blank to disable sending.
RESEND_API_KEY=
# Example after domain verification: Indie Clash <notifications@indieclash.com>
RESEND_FROM_EMAIL=
# Optional reply inbox, including a personal Gmail address.
RESEND_REPLY_TO=
# Email order links also use STRIPE_CHECKOUT_BASE_URL.
